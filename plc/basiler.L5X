<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(FLASH_02S.DN)[FFL(LOW_RAW,LOW_ARRAY[0],LOW_CONTROL1,?,?) ,FFU(LOW_ARRAY[0],LOW_LAST,LOW_CONTROL1,?,?) ,STD(LOW_ARRAY[0],0,LOW_STD1,LOW_CONTROL2,?,?) ];]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIO(FLASH_02S.DN)TON(FLASH_02S,?,?);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[CPT(LOW_DIFF,(LOW_ARRAY[8]+LOW_ARRAY[7]+LOW_ARRAY[6]+LOW_ARRAY[5])-(LOW_ARRAY[3]+LOW_ARRAY[2]+LOW_ARRAY[1]+LOW_ARRAY[0]));]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[CMP(LOW_DIFF>60)[[TON(LOW_TIMER5,?,?) ,XIC(LOW_TIMER5.DN) OTL(LOW_LOAD) ] ,XIC(LOW_LOAD) CPT(LOW_VALUE,(LOW_ARRAY[3]+LOW_ARRAY[2]+LOW_ARRAY[1]+LOW_ARRAY[0])/4) ];]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(LOW_LOAD)TON(LOW_TIMER3,?,?);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[CMP(LOW_RAW-LOW_VALUE<10)TON(LOW_TIMER4,?,?);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[[CMP(LOW_DIFF<-20) ,XIC(LOW_TIMER4.DN) ]XIC(LOW_TIMER3.DN)OTU(LOW_LOAD);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[CMP(LOW_DIFF<10)CMP(LOW_STD1<2)[TON(LOW_TIMER1,?,?) ,XIC(LOW_TIMER1.DN) OTE(FEED_STP) ];]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIO(LOW_LOAD)CMP(ABS(LOW_DIFF)<20)CMP(LOW_STD1<8)[TON(LOW_TIMER2,?,?) ,XIC(LOW_TIMER2.DN) OTE(H_SEN_LOW) ];]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[[OTE(H_LOW_OUTPUT) ,MOVE(H_LOW_INPUT,LOW_RAW) ];]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
