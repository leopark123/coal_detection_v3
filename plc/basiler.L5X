<Programs>
<Program Name="MainProgram" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false" UseAsFolder="false">
<Tags>
<Tag Name="SCL_01" TagType="Base" DataType="SCALE" Constant="false" ExternalAccess="Read/Write">
<Data Format="L5K">
<![CDATA[[1,0.00000000e+000,3.08400000e+004,0.00000000e+000,2.00000000e+001,4.00000000e+000,1,4.00000000e+000
		,0,0.00000000e+000,3.08400000e+004,3.24254215e-005,4.00000000e+000]]]>
</Data>
<Data Format="Decorated">
<Structure DataType="SCALE">
<DataValueMember Name="EnableIn" DataType="BOOL" Value="1"/>
<DataValueMember Name="In" DataType="REAL" Radix="Float" Value="0.0"/>
<DataValueMember Name="InRawMax" DataType="REAL" Radix="Float" Value="30840.0"/>
<DataValueMember Name="InRawMin" DataType="REAL" Radix="Float" Value="0.0"/>
<DataValueMember Name="InEUMax" DataType="REAL" Radix="Float" Value="20.0"/>
<DataValueMember Name="InEUMin" DataType="REAL" Radix="Float" Value="4.0"/>
<DataValueMember Name="Limiting" DataType="BOOL" Value="0"/>
<DataValueMember Name="EnableOut" DataType="BOOL" Value="1"/>
<DataValueMember Name="Out" DataType="REAL" Radix="Float" Value="4.0"/>
<DataValueMember Name="MaxAlarm" DataType="BOOL" Value="0"/>
<DataValueMember Name="MinAlarm" DataType="BOOL" Value="0"/>
<DataValueMember Name="Status" DataType="DINT" Radix="Hex" Value="16#0000_0000"/>
<DataValueMember Name="InstructFault" DataType="BOOL" Value="0"/>
<DataValueMember Name="InRawRangeInv" DataType="BOOL" Value="0"/>
</Structure>
</Data>
</Tag>
</Tags>
<Routines>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[NE(IPC_Heartbeat,HB_Last)MOVE(IPC_Heartbeat,HB_Last)RES(HB_Timer);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[TON(HB_Timer,?,?);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(IPC_Online)XIO(HB_Timer.DN)OTE(Vision_Alive);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIO(Vision_Alive)OTE(Fault_Light);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[[XIC(Vision_Enable) XIC(Vision_Alive) XIC(Vision_CanTip) XIC(Vision_ResultValid) EQ(Vision_FaultCode,0) ,XIO(Vision_Enable) ]OTE(Allow_Tip);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[EQ(Vision_FaultCode,4)OTE(Manual_Confirm_Light);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Tipper_InPosition)XIC(Vision_Enable)EQ(Vision_CaptureState,0)TON(Capture_Delay_Timer,?,?);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Capture_Delay_Timer.DN)EQ(PLC_CaptureCmd,0)MOVE(1,PLC_CaptureCmd);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[EQ(Vision_CaptureState,2)MOVE(0,PLC_CaptureCmd)RES(Capture_Delay_Timer);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[XIO(Tipper_InPosition)MOVE(0,PLC_CaptureCmd)RES(Capture_Delay_Timer);]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(Sim_Enable)TON(Sim_Timer,?,?);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[XIC(Sim_Enable)LIMIT(0,Sim_Timer.ACC,20000)OTE(Tipper_InPosition);]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(Sim_Timer.DN)RES(Sim_Timer);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
<Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false">
<ScheduledPrograms>
<ScheduledProgram Name="MainProgram"/>
</ScheduledPrograms>
</Task>
</Tasks>
