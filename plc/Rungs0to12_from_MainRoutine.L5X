<Description>
<![CDATA[服务器写，PLC 读]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="Vision_Enable" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[视觉采集使能]]>
</Description>
<Data Format="L5K">
<![CDATA[1]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="1"/>
</Data>
</Tag>
<Tag Name="Vision_FaultCode" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[0 正常
  - 1 相机故障
  - 2 图像无效
  - 3 算法异常
  - 4 通讯异常]]>
</Description>
<Data Format="L5K">
<![CDATA[0]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="0"/>
</Data>
</Tag>
<Tag Name="Vision_ResultValid" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[- 相机正常、当前帧处理成功、结果可信时置 1
  - 相机断开、图像异常、算法异常时置 0]]>
</Description>
<Data Format="L5K">
<![CDATA[1]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="1"/>
</Data>
</Tag>
</Tags>
<Programs Use="Context">
<Program Use="Context" Name="MainProgram">
<Routines Use="Context">
<Routine Use="Context" Name="MainRoutine">
<RLLContent Use="Context">
<Rung Use="Target" Number="0" Type="N">
<Text>
<![CDATA[NE(IPC_Heartbeat,HB_Last)MOVE(IPC_Heartbeat,HB_Last)RES(HB_Timer);]]>
</Text>
</Rung>
<Rung Use="Target" Number="1" Type="N">
<Text>
<![CDATA[TON(HB_Timer,?,?);]]>
</Text>
</Rung>
<Rung Use="Target" Number="2" Type="N">
<Text>
<![CDATA[XIC(IPC_Online)XIO(HB_Timer.DN)OTE(Vision_Alive);]]>
</Text>
</Rung>
<Rung Use="Target" Number="3" Type="N">
<Text>
<![CDATA[XIO(Vision_Alive)OTE(Fault_Light);]]>
</Text>
</Rung>
<Rung Use="Target" Number="4" Type="N">
<Text>
<![CDATA[[XIC(Vision_Enable) XIC(Vision_Alive) XIC(Vision_CanTip) XIC(Vision_ResultValid) EQ(Vision_FaultCode,0) ,XIO(Vision_Enable) ]OTE(Allow_Tip);]]>
</Text>
</Rung>
<Rung Use="Target" Number="5" Type="N">
<Text>
<![CDATA[EQ(Vision_FaultCode,4)OTE(Manual_Confirm_Light);]]>
</Text>
</Rung>
<Rung Use="Target" Number="6" Type="N">
<Text>
<![CDATA[XIC(Tipper_InPosition)XIC(Vision_Enable)EQ(Vision_CaptureState,0)TON(Capture_Delay_Timer,?,?);]]>
</Text>
</Rung>
<Rung Use="Target" Number="7" Type="N">
<Text>
<![CDATA[XIC(Capture_Delay_Timer.DN)EQ(PLC_CaptureCmd,0)MOVE(1,PLC_CaptureCmd);]]>
</Text>
</Rung>
<Rung Use="Target" Number="8" Type="N">
<Text>
<![CDATA[EQ(Vision_CaptureState,2)MOVE(0,PLC_CaptureCmd)RES(Capture_Delay_Timer);]]>
</Text>
</Rung>
<Rung Use="Target" Number="9" Type="N">
<Text>
<![CDATA[XIO(Tipper_InPosition)MOVE(0,PLC_CaptureCmd)RES(Capture_Delay_Timer);]]>
</Text>
</Rung>
<Rung Use="Target" Number="10" Type="N">
<Text>
<![CDATA[XIC(Sim_Enable)TON(Sim_Timer,?,?);]]>
</Text>
</Rung>
<Rung Use="Target" Number="11" Type="N">
<Text>
<![CDATA[XIC(Sim_Enable)LIMIT(0,Sim_Timer.ACC,20000)OTE(Tipper_InPosition);]]>
</Text>
</Rung>
<Rung Use="Target" Number="12" Type="N">
<Text>
<![CDATA[XIC(Sim_Timer.DN)RES(Sim_Timer);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
</Controller>
</RSLogix5000Content>
