<Tag Name="IPC_Heartbeat" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[工控机每5 00ms 加 1
       PLC 只检查它是否在变化
    如果长时间不变化，判定通讯异常]]>
</Description>
<Data Format="L5K">
<![CDATA[28642]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="28642"/>
</Data>
</Tag>
<Tag Name="IPC_Online" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write">
<Description>
<![CDATA[- 工控机程序启动成功后置 1
  - 程序关闭或异常时置 0
  - 如果 PLC 读不到，也按 0 处理]]>
</Description>
<Data Format="L5K">
<![CDATA[1]]>
</Data>
<Data Format="Decorated">
<DataValue DataType="BOOL" Radix="Decimal" Value="1"/>
</Data>
</Tag>
